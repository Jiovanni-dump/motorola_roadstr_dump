<?xml version="1.0" encoding="utf-8"?>
<!--
    Game optimizations device config
-->
<game-optimization version="1">

    <devconfig>
        <thermal-sensor>back_temp</thermal-sensor>
        <wifi-llm>true</wifi-llm>
        <fps-observer>true</fps-observer>
        <tgpa func="1,2,3,4,5,6,7,8" scene="1,2,3" >true</tgpa>
        <!-- temperatures from low to high -->
        <temp name="0" temp="0" tempClr="-10"/>
        <temp name="35" temp="35" tempClr="26"/>
        <temp name="36" temp="36" tempClr="34"/>
        <temp name="37" temp="37" tempClr="35"/>
        <temp name="38" temp="38" tempClr="36"/>
        <temp name="39" temp="39" tempClr="37"/>
        <temp name="40" temp="40" tempClr="38"/>
        <temp name="41" temp="41" tempClr="39"/>
        <temp name="42" temp="42" tempClr="40"/>
        <temp name="43" temp="43" tempClr="41"/>
        <temp name="44" temp="44" tempClr="42"/>
        <temp name="45" temp="45" tempClr="43"/>
        <temp name="46" temp="46" tempClr="44"/>
        <temp name="47" temp="47" tempClr="45"/>
        <temp name="48" temp="48" tempClr="46"/>
        <temp name="49" temp="49" tempClr="47"/>
        <temp name="50" temp="50" tempClr="48"/>
        <temp name="51" temp="51" tempClr="49"/>
        <temp name="52" temp="52" tempClr="50"/>
        <temp name="53" temp="53" tempClr="51"/>
        <temp name="54" temp="54" tempClr="52"/>
        <temp name="55" temp="55" tempClr="53"/>
        <temp name="56" temp="56" tempClr="54"/>
        <temp name="57" temp="57" tempClr="55"/>
        <temp name="58" temp="58" tempClr="56"/>
        <temp name="59" temp="59" tempClr="57"/>
        <temp name="60" temp="60" tempClr="58"/>
        <!-- cpu profiles from low to high
            MAX_FREQ_CLUSTER_BIG_CORE_0 = 0x40804000,
            MAX_FREQ_CLUSTER_LITTLE_CORE_0 = 0x40804100,
            MAX_FREQ_CLUSTER_PRIME_CORE_0 = 0x40804200,
            MIN_FREQ_CLUSTER_BIG_CORE_0 = 0x40800000,
            MIN_FREQ_CLUSTER_LITTLE_CORE_0 = 0x40800100,
            MIN_FREQ_CLUSTER_PRIME_CORE_0 = 0x40800200,
            MIN_ONLINE_CPU_CLUSTER_BIG = 0x41000000,
            MIN_ONLINE_CPU_CLUSTER_LITTLE = 0x41000100,
            MIN_ONLINE_CPU_CLUSTER_PRIME = 0x41000200,
            CORE_CTL_ENABLE_BIG = 0x41008000,
            CORE_CTL_ENABLE_PRIME  = 0x41008200,
            SCHED_BOOST = 0x40C00000,
            SCHED_ASYMCAP_BOOST = 0x43C00000,
            GPU_MIN_POWER_LEVEL = 0X42804000,
            GPU_MAX_POWER_LEVEL = 0X42808000,
            MPCTLV3_PID_AFFINE = 0x42C20000
            MPCTLV3_GPU_MIN_FREQ = 0X4280C000,
            MPCTLV3_GPU_MAX_FREQ = 0X42810000,
            MPCTLV3_WALT_ADAPTIVE_LOW_FREQ_BIG = 0x40808000,
            MPCTLV3_WALT_ADAPTIVE_HIGH_FREQ_BIG = 0x4080C000,
            MPCTLV3_WALT_RTG_CFS_BOOST_PRIO = 0x40CC8000,
        -->

        <profile-adjuster downFpsVar="0.5" downTimeout="10000" upFpsDrop="2" upFpsVar="5"/>
        <profile name="1">0x40804100, 1708, 0x40804000, 1612, 0x40804200, 1651, 0x41008000, 0, 0x41008200, 0</profile>
        <profile name="2">0x40804100, 1708, 0x40804000, 1920, 0x40804200, 1900, 0x41008000, 0, 0x41008200, 0</profile>
        <profile name="3">0x40804100, 1843, 0x40804000, 2208, 0x40804200, 2304, 0x41008000, 0, 0x41008200, 0</profile>
        <profile name="4">0x40804100, 1843, 0x40804000, 2208, 0x40804200, 2496, 0x41008000, 0, 0x41008200, 0</profile>
        <profile name="5">0x40804100, 1843, 0x40804000, 2400, 0x40804200, 2803, 0x41008000, 0, 0x41008200, 0</profile>

        <profile name="boost_sched_mincpu">0x40C00000, 1, 0x40CC8000, 119, 0x40800000, 1401, 0x40800200, 1324</profile>
        <profile name="boost_sched_maxcpu">0x40C00000, 1, 0x40800000, 2400, 0x40800200, 2803</profile>
        <profile name="boost_sched">0x40C00000, 1, 0x40CC8000, 119</profile>
        <profile name="gmg">0x40804000, 1920, 0x40804200, 633</profile>
    </devconfig>

    <!-- base game -->
    <optimization name="base_game" mode="normal">
        <!-- thermal>game-normal</thermal -->
        <default-rr>60</default-rr>
        <thermal>gb</thermal>
        <llm>true</llm>
        <limit temp="0" profile="1-5"/>
        <limit temp="41" rr="60" profile="1-4"/>
        <limit temp="43" rr="90" fps="45" profile="1-3" vol-max="-2,-2"/>
        <limit temp="45" rr="60" fps="30" profile="1-2" vol-max="-3,-3"/>
    </optimization>
    <optimization name="base_game" mode="perf">
        <!-- thermal>game-perf</thermal -->
        <default-rr>auto</default-rr>
        <thermal>game-perf</thermal>
        <llm>true</llm>
        <limit temp="0" profile="2-5"/>
        <limit temp="42" profile="2-5" vol-max="-2,-2"/>
        <limit temp="44" rr="60" profile="2-3" vol-max="-3,-3"/>
        <limit temp="46" rr="90" fps="45" profile="2" vol-max="-3,-3"/>
        <limit temp="48" rr="60" fps="30" profile="2" vol-max="-3,-3"/>
        <boost framedrop="10" profile="boost_sched_mincpu"/>
    </optimization>
    <optimization name="base_game" mode="powersave">
        <!-- thermal>game-normal</thermal -->
        <battery-saver>true</battery-saver>
        <default-rr>60</default-rr>
        <thermal>gb</thermal>
        <llm>true</llm>
        <limit temp="0" rr="60" profile="1-5"/>
        <limit temp="43" rr="60" fps="30" profile="1-2" vol-max="-3,-3"/>
    </optimization>

    <!-- 60fps game -->
    <optimization name="60fps_game" parent="base_game">
        <default-rr>60</default-rr>
    </optimization>
    <optimization name="60fps_heavy_game" parent="60fps_game">
        <upmigrate fps="40"/>
    </optimization>
    <optimization name="60fps_restricted_game" parent="60fps_heavy_game" mode="normal">
        <limit temp="0" rr="60" fps="45" profile="1-5"/>
        <limit temp="42" rr="60" fps="45" profile="1-3" vol-max="-2,-2"/>
        <limit temp="44" rr="60" fps="45" profile="1-2" vol-max="-3,-3"/>
    </optimization>
    <optimization name="60fps_restricted_game" parent="60fps_heavy_game" mode="perf">
        <limit temp="0"/>
        <limit temp="42" vol-max="-2,-2"/>
        <limit temp="44" rr="60" fps="45" vol-max="-3,-3"/>
        <boost profile="boost_sched"/>
    </optimization>
    <optimization name="60fps_restricted_game" parent="60fps_heavy_game" mode="powersave">
    </optimization>
    <!-- 90fps game -->
    <optimization name="90fps_game" parent="base_game">
        <default-rr>90</default-rr>
    </optimization>
    <optimization name="90fps_heavy_game" parent="90fps_game">
        <upmigrate fps="70"/>
    </optimization>
    <!-- 120fps game -->
    <optimization name="120fps_game" parent="base_game">
        <default-rr>120</default-rr>
    </optimization>
    <optimization name="120fps_heavy_game" parent="120fps_game">
        <upmigrate fps="100"/>
    </optimization>
    <!-- 144fps game -->
    <optimization name="144fps_game" parent="base_game">
        <default-rr>120</default-rr>
    </optimization>

    <!-- smooth game -->
    <optimization name="smooth_game" parent="base_game">
        <default-rr>90</default-rr>
        <autolite-rr>120</autolite-rr>
    </optimization>

    <!-- GenshinImpact -->
    <optimization name="genshin_game" parent="60fps_restricted_game" mode="normal">
        <limit temp="0" rr="60" fps="45" profile="1-5"/>
        <limit temp="40" rr="60" fps="40" profile="1-5"/>
        <limit temp="42" rr="60" fps="40" profile="1-3" vol-max="-2,-2"/>
        <limit temp="44" rr="60" fps="30" profile="1-2" vol-max="-3,-3"/>
    </optimization>
    <optimization name="genshin_game" parent="60fps_restricted_game" mode="perf">
        <limit temp="0"/>
        <limit temp="42" vol-max="-2,-2"/>
        <limit temp="44" rr="60" fps="45" vol-max="-3,-3"/>
        <limit temp="46" rr="60" fps="40" vol-max="-3,-3"/>
        <limit temp="48" rr="60" fps="30" vol-max="-3,-3"/>
    </optimization>
    <optimization name="genshin_game" parent="60fps_restricted_game" mode="powersave">
    </optimization>

    <!--hkrpg_game -->
    <optimization name="hkrpg_game" parent="60fps_restricted_game" mode="normal">
        <limit temp="0" rr="60" fps="45" profile="1-5"/>
        <limit temp="38" rr="60" fps="40" profile="1-5"/>
        <limit temp="42" rr="60" fps="30" profile="1-3" vol-max="-2,-2"/>
        <limit temp="44" rr="60" fps="30" profile="1-2" vol-max="-3,-3"/>
    </optimization>
    <optimization name="hkrpg_game" parent="60fps_restricted_game" mode="perf">
        <limit temp="0"/>
        <limit temp="40" rr="60" fps="45"/>
        <limit temp="42" rr="60" fps="40" vol-max="-2,-2"/>
        <limit temp="44" rr="60" fps="30" vol-max="-3,-3"/>
    </optimization>
    <optimization name="hkrpg_game" parent="60fps_restricted_game" mode="powersave">
    </optimization>

    <!-- koh game 120fps-->
    <optimization name="koh_game_120fps" parent="120fps_heavy_game" mode="normal">
        <limit temp="0" profile="1-5"/>
        <limit temp="42" rr="90" profile="1-3" vol-max="-2,-2"/>
        <limit temp="44" rr="60" profile="1-2" vol-max="-3,-3"/>
        <limit temp="46" rr="90" fps="45" profile="1" vol-max="-3,-3"/>
    </optimization>
    <optimization name="koh_game_120fps" parent="120fps_heavy_game" mode="perf">
        <limit temp="0" profile="2-5"/>
        <limit temp="42" profile="2-5" vol-max="-2,-2"/>
        <limit temp="44" profile="2-3" vol-max="-3,-3"/>
        <limit temp="46" profile="2" vol-max="-3,-3"/>
        <limit temp="48" profile="2" vol-max="-3,-3"/>
        <boost framedrop="5" profile="boost_sched_mincpu"/>
    </optimization>
    <optimization name="koh_game_120fps" parent="120fps_heavy_game" mode="powersave">
    </optimization>

    <!-- cod game 120fps -->
    <optimization name="cod_game_120fps" parent="120fps_heavy_game" mode="normal">
        <limit temp="0" profile="1-5"/>
        <limit temp="42" rr="90" profile="1-3" vol-max="-2,-2"/>
        <limit temp="44" rr="60" profile="1-2" vol-max="-3,-3"/>
        <limit temp="46" rr="90" fps="45" profile="1" vol-max="-3,-3"/>
    </optimization>
    <optimization name="cod_game_120fps" parent="120fps_heavy_game" mode="perf">
        <limit temp="0" profile="2-5"/>
        <limit temp="42" profile="2-5" vol-max="-2,-2"/>
        <limit temp="44" profile="2-3" vol-max="-3,-3"/>
        <limit temp="46" profile="2" vol-max="-3,-3"/>
        <limit temp="48" profile="2" vol-max="-3,-3"/>
        <boost framedrop="5" profile="boost_sched_mincpu"/>
    </optimization>
    <optimization name="cod_game_120fps" parent="120fps_heavy_game" mode="powersave">
    </optimization>

    <!-- pubg game 120fps-->
    <optimization name="pubg_game_120fps" parent="120fps_heavy_game" mode="normal">
        <limit temp="0" />
        <limit temp="42" rr="60" vol-max="-2,-2"/>
        <limit temp="44" rr="90" fps="45" vol-max="-3,-3"/>
    </optimization>
    <optimization name="pubg_game_120fps" parent="120fps_heavy_game" mode="perf">
        <limit temp="0" />
        <limit temp="42" vol-max="-2,-2"/>
        <limit temp="44" vol-max="-3,-3"/>
        <limit temp="46" vol-max="-3,-3"/>
        <limit temp="48" vol-max="-3,-3"/>
        <boost framedrop="5" profile="boost_sched_mincpu"/>
    </optimization>
    <optimization name="pubg_game_120fps" parent="120fps_heavy_game" mode="powersave">
    </optimization>

    <!-- global mini game-->
    <optimization name="mini_game" parent="base_game" mode="normal">
        <limit profile="gmg"/>
    </optimization>
    <optimization name="mini_game" parent="base_game" mode="perf">
        <limit profile="gmg"/>
    </optimization>
    <optimization name="mini_game" parent="base_game" mode="powersave">
    </optimization>

    <!-- other games -->
    <optimization name="other_games" parent="base_game">
    </optimization>

    <optimization name="com.tencent.tmgp.sgame" refs="koh_game_120fps" />
    <optimization name="com.tencent.tmgp.sgamece" refs="koh_game_120fps" />
    <optimization name="com.miHoYo.Yuanshen" refs="genshin_game" />
    <optimization name="com.miHoYo.GenshinImpact" refs="genshin_game" />
    <optimization name="com.miHoYo.hkrpg" refs="hkrpg_game" />
    <optimization name="com.HoYoverse.hkrpgoversea" refs="hkrpg_game" />
    <optimization name="com.tencent.tmgp.pubgmhd" refs="pubg_game_120fps" />
    <optimization name="com.tencent.ig" refs="pubg_game_120fps" />
    <optimization name="com.pubg.imobile" refs="pubg_game_120fps" />

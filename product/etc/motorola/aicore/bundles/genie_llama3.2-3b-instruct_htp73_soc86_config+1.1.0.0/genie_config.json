{
    "dialog": {
        "version": 1,
        "type": "ssd-q1",
        "max-num-tokens": 2048,
        "stop-sequence": [
        "<|begin_of_text|>",
        "<|eot_id|>",
        "<|end_of_text|>",
        "\\n\\n\\n\\n\\n"
        ],
        "context": {
            "version": 1,
            "size": 2048,
            "n-vocab": 128256,
            "bos-token": 128000,
            "eos-token": [
                128001,
                128008,
                128009
            ],
            "pad-token": 128001
        },
        "sampler": {
            "version": 1,
            "seed": 12,
            "temp": 1.0,
            "top-k": 1,
            "top-p": 1.0,
            "greedy": true,
            "token-penalty": {
                "version" : 1,
                "penalize-last-n": 0,
                "repetition-penalty": 1.0,
                "presence-penalty": 0.0,
                "frequency-penalty": 0.0
                }
        },
        "tokenizer": {
            "version": 1,
            "path": "tokenizer.json"
        },
        "engine": {
            "version": 1,
            "n-threads": 3,
            "backend": {
                "version": 1,
                "type": "QnnHtp",
                "QnnHtp": {
                    "version": 1,
                    "use-mmap": true,
                    "spill-fill-bufsize": 0,
                    "mmap-budget": 40,
                    "poll": true,
                    "cpu-mask": "0xe0",
                    "kv-dim": 128,
                    "allow-async-init": true,
                    "enable-graph-switching": true
                },
                "extensions": "htp_backend_ext_config.json"
            },
            "model": {
                "version": 1,
                "type": "binary",
                "binary": {
                    "version": 1,
                    "ctx-bins": [
                        "weight_sharing_model_ar128_ar32_cl2048_2_of_3.serialized.bin",
                        "weight_sharing_model_ar128_ar32_cl2048_3_of_3.serialized.bin"
                    ],
                    "lora": {
                        "version": 1,
                        "alpha-tensor-name": "lora_alpha",
                        "adapters": [ ]
                    }
                },
                "positional-encoding": {
                    "type": "rope",
                    "rope-dim": 64,
                    "rope-theta": 500000,
                    "rope-scaling": {
                        "factor": 32.0,
                        "high-freq-factor": 4.0,
                        "low-freq-factor": 1.0,
                        "original-max-position-embeddings": 8192,
                        "rope-type": "llama3"
                    }
                }
            }
        },
        "ssd-q1": {
            "version": 1,
            "ssd-version": 1,
            "forecast-token-count": 2,
            "forecast-prefix": 4,
            "forecast-prefix-name": "forecast-prefix",
            "branches": [
                3,
                2
            ],
            "n-streams": 1,
            "p-threshold": 0.0
        },
        "embedding": {
            "version": 1,
            "type": "lut",
            "lut-path": "quantized_embedding_table.bin",
            "size": 3072,
            "datatype": "ufixed8",
            "quant-param": {
                "scale": 0.001118259853683412,
                "offset": -128
            }
        }
    }
}
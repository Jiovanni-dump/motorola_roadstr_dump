    <optimization name="com.kiloo.subwaysurf" refs="smooth_game" />
    <optimization name="com.mojang.minecrafttrialpe" refs="smooth_game" />
    <optimization name="com.imangi.templerun2" refs="smooth_game" />

</game-optimization>
